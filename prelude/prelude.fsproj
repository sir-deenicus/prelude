<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net5</TargetFrameworks>
    <LangVersion>preview</LangVersion> 
    <Company />
    <Authors>Deen Abiola</Authors>
    <Description>Set of useful Fsharp utility functions.</Description>
    <Version>2.1.0</Version>
    <PackageId>Prelude</PackageId>
    <AssemblyName>Prelude</AssemblyName>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild> 
    <RunPostBuildEvent>2</RunPostBuildEvent>
    <GitHubPackagesOwner>sir-deenicus</GitHubPackagesOwner>
    <GitHubPackagesSource>https://nuget.pkg.github.com/$(GitHubPackagesOwner)/index.json</GitHubPackagesSource>
    <LocalPackageCache>C:\Users\cybernetic\Code\Packages\</LocalPackageCache>
    <GitHubPackagesConfigPath>$(BaseIntermediateOutputPath)github-packages.nuget.config</GitHubPackagesConfigPath>
  </PropertyGroup> 
  <PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Debug|netstandard2.1|AnyCPU'">
    <DocumentationFile>Prelude.XML</DocumentationFile>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Release|netstandard2.1|AnyCPU'">
    <DocumentationFile>Prelude.XML</DocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="dagre-template.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </EmbeddedResource>
    <None Include="pairheap.fsx" />
    <None Include="obsolete.txt" />
    <None Include="some tests.fsx" />
    <Compile Include="prelude.fs" />
    <Compile Include="math.fs" />
    <Compile Include="onlinelearning.fs" />
    <Compile Include="Reducers.fs" />
    <Compile Include="FibonacciHeap.fs" />
    <Compile Include="ProbabilityTools.fs" />
    <Compile Include="SimpleGraph.fs" />
    <Compile Include="SimpleDirectedGraph.fs" />
    <Compile Include="SimpleTrees.fs" />
    <Compile Include="GraphAlgorithms.fs" />
    <Compile Include="Control.fs" />
    <Compile Include="StringMetrics.fs" />
    <Compile Include="Trie.fs" />
    <Compile Include="TrieStringSearch.fs" />
  </ItemGroup>
  <ItemGroup />
  <ItemGroup>
    <PackageReference Include="DictionarySlim" Version="1.0.0" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Update="FSharp.Core" Version="8.0.100" />
  </ItemGroup>
  <Target Name="PostBuild" AfterTargets="Pack" Condition="'$(Configuration)' == 'Release'">
    <PropertyGroup>
      <PackedPackagePath>$(PackageOutputPath)$(PackageId).$(Version).nupkg</PackedPackagePath>
    </PropertyGroup>
    <Message Importance="High" Text="Skipping GitHub Packages push because GITHUB_PAT is not set." Condition="'$(GITHUB_PAT)' == ''" />
    <ItemGroup Condition="'$(GITHUB_PAT)' != ''">
      <GitHubPackagesConfigLines Include="&lt;?xml version=&quot;1.0&quot; encoding=&quot;utf-8&quot;?&gt;" />
      <GitHubPackagesConfigLines Include="&lt;configuration&gt;" />
      <GitHubPackagesConfigLines Include="  &lt;packageSources&gt;" />
      <GitHubPackagesConfigLines Include="    &lt;clear /&gt;" />
      <GitHubPackagesConfigLines Include="    &lt;add key=&quot;github&quot; value=&quot;$(GitHubPackagesSource)&quot; /&gt;" />
      <GitHubPackagesConfigLines Include="  &lt;/packageSources&gt;" />
      <GitHubPackagesConfigLines Include="  &lt;packageSourceCredentials&gt;" />
      <GitHubPackagesConfigLines Include="    &lt;github&gt;" />
      <GitHubPackagesConfigLines Include="      &lt;add key=&quot;Username&quot; value=&quot;$(GitHubPackagesOwner)&quot; /&gt;" />
      <GitHubPackagesConfigLines Include="      &lt;add key=&quot;ClearTextPassword&quot; value=&quot;%GITHUB_PAT%&quot; /&gt;" />
      <GitHubPackagesConfigLines Include="    &lt;/github&gt;" />
      <GitHubPackagesConfigLines Include="  &lt;/packageSourceCredentials&gt;" />
      <GitHubPackagesConfigLines Include="&lt;/configuration&gt;" />
    </ItemGroup>
    <WriteLinesToFile File="$(GitHubPackagesConfigPath)" Lines="@(GitHubPackagesConfigLines)" Overwrite="true" Condition="'$(GITHUB_PAT)' != '' and Exists('$(PackedPackagePath)')" />
    <Exec Command="dotnet nuget push &quot;$(PackedPackagePath)&quot; --source github --skip-duplicate --configfile &quot;$(GitHubPackagesConfigPath)&quot;" ContinueOnError="true" Condition="'$(GITHUB_PAT)' != '' and Exists('$(PackedPackagePath)')" />
    <Delete Files="$(GitHubPackagesConfigPath)" Condition="Exists('$(GitHubPackagesConfigPath)')" />
    <Copy SourceFiles="$(PackedPackagePath)" DestinationFolder="$(LocalPackageCache)" Condition="Exists('$(PackedPackagePath)')" />
    <Delete Files="$(PackedPackagePath)" Condition="Exists('$(PackedPackagePath)')" />
  </Target> 
</Project>

